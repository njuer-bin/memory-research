ACTION: run_python
import pandas as pd
import numpy as np

df = pd.read_csv('train_v1.csv')

# 尝试手动计算组均值差和置信区间，避免依赖外部脚本
group_a = df[df['group'] == 'A']['y']
group_b = df[df['group'] == 'B']['y']

delta = group_a.mean() - group_b.mean()
n_a = len(group_a)
n_b = len(group_b)
n_total = n_a + n_b

# 计算标准误差
pooled_std = np.sqrt(((n_a - 1) * group_a.var() + (n_b - 1) * group_b.var()) / (n_a + n_b - 2))
standard_error = pooled_std * np.sqrt(1/n_a + 1/n_b)

# 计算 95% 置信区间
confidence_interval = 1.96 * standard_error
ci_lower = delta - confidence_interval
ci_upper = delta + confidence_interval

print(f"DELTA: {round(delta, 3)}")
print(f"CI: [{round(ci_lower, 3)}, {round(ci_upper, 3)}]")
print(f"N: {n_total}")

