import pandas as pd
import numpy as np

df = pd.read_csv('train_v1.csv')

# 使用 robust_groupdiff.py 计算组均值差和置信区间
try:
    from robust_groupdiff import robust_groupdiff
    result = robust_groupdiff(df, 'group', 'y')
    delta = result['delta']
    ci_lower = result['ci_lower']
    ci_upper = result['ci_upper']
    n_total = result['n_total']
    print(f"DELTA: {round(delta, 3)}")
    print(f"CI: [{round(ci_lower, 3)}, {round(ci_upper, 3)}]")
    print(f"N: {n_total}")

except ImportError:
    print("Error: robust_groupdiff.py not found. Please ensure it's in the correct directory.")
    exit()

