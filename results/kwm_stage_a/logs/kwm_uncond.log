ACTION: run_python
import pandas as pd, numpy as np
df = pd.read_csv('train_v1.csv')
sub = df.dropna(subset=['y'])
a = sub[sub.group=='A'].y; b = sub[sub.group=='B'].y
delta = a.mean()-b.mean(); nA, nB = len(a), len(b)
sp = np.sqrt(((nA-1)*a.var()+(nB-1)*b.var())/(nA+nB-2))
se = sp*np.sqrt(1/nA+1/nB); lo, hi = delta-1.96*se, delta+1.96*se
print('DELTA', round(delta,3), 'CI', round(lo,3), round(hi,3), 'N', len(sub))
print(a.describe(), b.describe())
